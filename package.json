{
  "name": "svensk-laxhjalp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "android:build:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle:release": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy:hosting": "npm run build && firebase deploy --only hosting,firestore:rules",
    "deploy:api": "gcloud run deploy laxhjalp-api --source . --region europe-west1 --project lead-agent-489101 --allow-unauthenticated --min-instances 0 --max-instances 2 --timeout=120",
    "deploy": "npm run deploy:hosting && npm run deploy:api",
    "migrate:firestore": "node scripts/migrate-firestore-named-to-default.mjs",
    "migrate:firestore:reset": "node scripts/migrate-firestore-named-to-default.mjs --reset"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^8.3.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.0.0",
    "i18next": "^26.0.1",
    "katex": "^0.16.45",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.6.18",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
