# Required: Gemini API key (server-side only, never exposed to browser)
GEMINI_API_KEY="your-gemini-api-key"

# Sätt till true när abonnemang är live och gratis-tak (chat/bild/TTS) ska gälla igen. Default: av.
# ENFORCE_SUBSCRIPTION_LIMITS="true"

# Optional: Google Cloud Text-to-Speech API-nyckel för "Lyssna"-knappen.
# Om osatt: klienten faller tillbaka till webbläsarens inbyggda TTS (gratis, helt lokalt).
# Setup (ca 3 min): Google Cloud Console → APIs & Services → Enable "Cloud Text-to-Speech API" → Credentials → Create API key.
# Separat från GEMINI_API_KEY (om du inte explicit aktiverat båda på samma nyckel).
#
# Kostnad med default-inställning (Standard-röster):
#   • $4 per 1 M tecken. Google ger 4 M tecken gratis/mån → ~4500 Lyssna-anrop/mån gratis.
#   • Gratisanvändare: FREE_AI_TTS_PER_DAY = 20/dag.
#
# Sätt GOOGLE_TTS_USE_NEURAL=true om du vill ha Neural2-röst först (4× dyrare, 1 M gratis/mån).
GOOGLE_TTS_API_KEY=""
# GOOGLE_TTS_USE_NEURAL="true"

# Optional: Override AI models (defaults shown match server/routes/ai.ts — keep in sync)
AI_TEXT_MODEL="gemini-2.5-flash-lite"
AI_IMAGE_MODEL="gemini-2.5-flash-image"
# Modell för bildanalys i chatten (foton av läxor) — separat från AI_TEXT_MODEL/AI_IMAGE_MODEL,
# annars påverkar inte AI_TEXT_MODEL den (troligen dyraste) bildanalys-vägen.
AI_IMAGE_ANALYSIS_MODEL="gemini-2.5-flash"

# Tak på svarslängd (tokens) — skydd mot skenande/looping genereringar. Höj om långa
# fullständiga facit-svar (flera deluppgifter) börjar klippas av.
AI_MAX_OUTPUT_TOKENS="4096"

# Firestore använder nu alltid "(default)" i klient + server.
# Sätt inte FIRESTORE_DATABASE_ID om du inte avsiktligt vill peka om backend.

# Optional: Firebase service account JSON (for local dev auth verification)
# On Cloud Run, this is not needed if the service runs in the same project
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Extra CORS-origins (kommaseparerat). Cloud Run tillåter redan web.app + foraldrahjalpen.se + localhost.
# ALLOWED_ORIGIN="https://staging.example.com"

# Valfri override av API-URL i Vite-bygget (annars används inbyggd Cloud Run-URL i prod).
# VITE_API_ORIGIN="https://laxhjalp-api-....run.app"

# Vercel: api/chat.ts och api/image.ts är tunna proxyer mot Cloud Run (server/routes/ai.ts) —
# de anropar inte Gemini direkt, så att gratisgränser/caching/systemprompter bara finns på ett ställe.
# Sätts normalt inte manuellt; override bara om Cloud Run-tjänsten byter URL.
# CLOUD_RUN_API_ORIGIN="https://laxhjalp-api-....run.app"

# Betalningar: Stripe är borttaget (2026) inför App Store-inlämning — Apple kräver i praktiken
# native In-App Purchase för den här typen av app. Tjänsten är helt gratis tills det är byggt.

# Admin dashboard — sole operator only (pick ONE style):
#
# A) Strongest: ADMIN_UID (+ optional ADMIN_EMAIL). Same VITE_ADMIN_UID (+ optional VITE_ADMIN_EMAIL).
# B) Email only: set ADMIN_EMAIL and VITE_ADMIN_EMAIL (no UID). Must log in with that Google/email account.
#
# ADMIN_UID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ADMIN_EMAIL="you@example.com"
# VITE_ADMIN_UID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VITE_ADMIN_EMAIL="you@example.com"
#
# Local tip: put overrides in .env.local (gitignored); server loads .env.local automatically.
#
# --- Vercel ---
# Dashboard: Project → Settings → Environment Variables
# - Add ADMIN_UID and ADMIN_EMAIL for Production (and Preview if needed). Same values as above.
# - Add VITE_ADMIN_UID and VITE_ADMIN_EMAIL for Production — required at *build* time so Vite embeds them.
# - Keep FIREBASE_SERVICE_ACCOUNT (JSON string) so /api/* functions can talk to Firestore.
# After changing VITE_* vars, trigger a new deployment (Redeploy).
