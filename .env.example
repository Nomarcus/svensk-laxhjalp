# Required: Gemini API key (server-side only, never exposed to browser)
GEMINI_API_KEY="your-gemini-api-key"

# Sätt till true när abonnemang är live och gratis-tak (chat/bild/TTS) ska gälla igen. Default: av.
# ENFORCE_SUBSCRIPTION_LIMITS="true"

# Optional: Google Cloud Text-to-Speech API key (neural voices for "Lyssna" in chat).
# Create in Google Cloud Console → APIs → Cloud Text-to-Speech API → Credentials → API key.
# Separate from AI Studio / GEMINI_API_KEY unless your project uses a key with both enabled.
GOOGLE_TTS_API_KEY=""

# Optional: Override AI models (defaults shown)
AI_TEXT_MODEL="gemini-2.0-flash-lite"
AI_IMAGE_MODEL="gemini-2.0-flash-preview-image-generation"

# Firestore använder nu alltid "(default)" i klient + server.
# Sätt inte FIRESTORE_DATABASE_ID om du inte avsiktligt vill peka om backend.

# Optional: Firebase service account JSON (for local dev auth verification)
# On Cloud Run, this is not needed if the service runs in the same project
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Extra CORS-origins (kommaseparerat). Cloud Run tillåter redan web.app + foraldrahjalpen.se + localhost.
# ALLOWED_ORIGIN="https://staging.example.com"

# Valfri override av API-URL i Vite-bygget (annars används inbyggd Cloud Run-URL i prod).
# VITE_API_ORIGIN="https://laxhjalp-api-....run.app"

# Stripe Buy Button (legacy; ersätts av Payment Links nedan):
# VITE_ENABLE_STRIPE_BUY_BUTTON="false"
# VITE_STRIPE_BUY_BUTTON_ID="buy_btn_..."
# VITE_STRIPE_PUBLISHABLE_KEY="pk_live_... eller pk_test_..."
# VITE_STRIPE_TRIAL_DAYS="10"

# Abonnemangssidan — en Payment Link för 49 kr/mån (Vite, byggtid). Default-URL finns i kod; override med valfri av:
# VITE_STRIPE_PAYMENT_LINK="https://buy.stripe.com/..."
# VITE_STRIPE_PAYMENT_LINK_PLUS="https://buy.stripe.com/..."
# VITE_STRIPE_PAYMENT_LINK_PREMIUM="https://buy.stripe.com/..."

# Stripe (required for payments)
# Måste vara Stripe Secret Key (börjar med sk_test_ eller sk_live_) — inte webhook-secret (whsec_...).
STRIPE_SECRET_KEY="sk_test_..."
# Webhook endpoint i Stripe Dashboard ska använda sökvägen /api/webhook/stripe så Firebase Hosting skickar till Cloud Run:
#   https://lead-agent-489101.web.app/api/webhook/stripe
# (Äldre URL utan /api träffade bara index.html och uppdaterade aldrig Firestore.)
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."
# Valfritt: Price ID för lägre nivå (Plus). Om utelämnad: all aktiv betal-prenumeration → tier "plus" i Firestore.
# Om satt: endast denna price → "plus", övriga betalande → "pro" (t.ex. om du har två Stripe-priser).
# STRIPE_PRICE_ID_PLUS="price_..."
CLIENT_URL="https://lead-agent-489101.web.app"

# Admin dashboard — sole operator only (pick ONE style):
#
# A) Strongest: ADMIN_UID (+ optional ADMIN_EMAIL). Same VITE_ADMIN_UID (+ optional VITE_ADMIN_EMAIL).
# B) Email only: set ADMIN_EMAIL and VITE_ADMIN_EMAIL (no UID). Must log in with that Google/email account.
#
# ADMIN_UID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ADMIN_EMAIL="you@example.com"
# VITE_ADMIN_UID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VITE_ADMIN_EMAIL="you@example.com"
#
# Local tip: put overrides in .env.local (gitignored); server loads .env.local automatically.
#
# --- Vercel ---
# Dashboard: Project → Settings → Environment Variables
# - Add ADMIN_UID and ADMIN_EMAIL for Production (and Preview if needed). Same values as above.
# - Add VITE_ADMIN_UID and VITE_ADMIN_EMAIL for Production — required at *build* time so Vite embeds them.
# - Keep FIREBASE_SERVICE_ACCOUNT (JSON string) so /api/* functions can talk to Firestore.
# After changing VITE_* vars, trigger a new deployment (Redeploy).
